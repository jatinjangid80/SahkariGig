# =======================================================
# CoopGig — Cooperative Gig Services Platform (.env.example)
# Documenting Client & Server Environment Variables
# =======================================================

# Server Configuration
PORT=5001
NODE_ENV=development
JWT_SECRET=your_secure_jwt_secret_here

# MongoDB Atlas Database URI (Never expose in frontend)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/coopgig?retryWrites=true&w=majority

# Firebase Authentication (Server-Side Admin SDK)
FIREBASE_PROJECT_ID=coopgig
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# UPI Payment Gateway Integration
UPI_ID=janseva.coop@upi
UPI_PAYEE_NAME=Cooperative Gig Services

# Client Configuration (Exposed via Vite - VITE_ prefix)
VITE_API_URL=http://localhost:5001
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=coopgig.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=coopgig
VITE_FIREBASE_STORAGE_BUCKET=coopgig.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
