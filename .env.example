# =======================================================
# CoopGig — Cooperative Gig Services Platform (.env.example)
# Documenting Client & Server Environment Variables
# =======================================================

# Supabase PostgreSQL Database Credentials
SUPABASE_PROJECT_ID=gjriuaexwaklsyctffli
SUPABASE_URL=https://gjriuaexwaklsyctffli.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Server Configuration
PORT=5001
NODE_ENV=development
JWT_SECRET=your_secure_jwt_secret_here

# MongoDB Atlas Database URI (Optional Fallback)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/coopgig?retryWrites=true&w=majority

# Client Configuration (Exposed via Vite - VITE_ prefix)
VITE_API_URL=http://localhost:5001
VITE_SUPABASE_URL=https://gjriuaexwaklsyctffli.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key
